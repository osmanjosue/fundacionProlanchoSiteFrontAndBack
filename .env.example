# Variables de entorno del backend (copiar a .env y completar)

PORT=

# Base de datos
DB_CNN=

# Autenticación
JWT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# n8n (chat) — secreto que el backend usa para autenticarse hacia n8n
N8N_WEBHOOK_URL=
N8N_API_KEY=

# Cloudflare Turnstile (anti-bot del chat) — OPCIONAL.
# Si se deja vacío, la verificación anti-bot queda desactivada (inerte).
# Obtener la clave secreta en: https://dash.cloudflare.com/ -> Turnstile
TURNSTILE_SECRET_KEY=

# Correo
MAILER_SERVICE=
MAILER_EMAIL=
MAILER_SECRET_KEY=
