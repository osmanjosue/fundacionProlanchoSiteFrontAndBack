# ==========================================================================
# Variables de entorno del backend
# Copiar este archivo a .env y completar los valores reales.
# El .env NO se sube a git (está en .gitignore): cada entorno (local / VPS)
# mantiene su propia copia. Al desplegar, recordá replicar las variables nuevas.
# ==========================================================================

# Puerto donde escucha el servidor Express.
PORT=3000

# --- Base de datos (MongoDB) ---
DB_CNN=

# --- Autenticación ---
# Secreto para firmar los JWT.
JWT_SECRET=

# UID (ObjectId de Mongo) del usuario administrador.
# Fuente única para la autorización de creación de usuarios (middleware validar-admin).
ADMIN_UID=

# --- Cloudinary (almacenamiento de imágenes) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# --- n8n (automatizaciones) ---
# El backend reenvía a estos webhooks agregando N8N_API_KEY como secreto del lado servidor.
# Webhook del chatbot con IA.
N8N_WEBHOOK_URL=
# Webhook de reserva de citas (en prod, la URL va SIN el segmento "-test").
N8N_BOOKING_WEBHOOK_URL=
# API key que el backend envía a n8n (header x-api-key). Compartida por ambos webhooks.
N8N_API_KEY=

# --- Cloudflare Turnstile (anti-bot del chat) — OPCIONAL ---
# Si se deja vacío, la verificación anti-bot queda desactivada (inerte).
# Obtener la clave secreta en: https://dash.cloudflare.com/ -> Turnstile
TURNSTILE_SECRET_KEY=

# --- Correo (nodemailer / Gmail SMTP) ---
MAILER_SERVICE=gmail
MAILER_EMAIL=
# Contraseña de aplicación de Gmail (no la contraseña normal de la cuenta).
MAILER_SECRET_KEY=
# Validación del certificado TLS del servidor SMTP.
# Por defecto (sin esta variable) se validan los certificados (seguro = true).
# El VPS de producción requiere desactivarla por certificados estrictos en Linux:
#   poner en "false" para que el envío de correo funcione en el servidor.
MAILER_TLS_REJECT_UNAUTHORIZED=false

# --- Correo del sitio drafrancisherrera.com (Brevo / SMTP) ---
# Independiente del Gmail de arriba: otra cuenta, otro sitio. El formulario de
# contacto del sitio envía aquí y el correo llega a la bandeja de la doctora.
# Credenciales SMTP en Brevo: panel -> SMTP & API -> SMTP.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
# Remitente: debe estar verificado en Brevo (verificación por clic, sin DNS).
DRAFRANCISHERRERA_MAIL_FROM=
# Destinatario(s) donde se reciben las consultas del formulario.
# Admite uno o varios correos separados por coma (ej. doctora@x.com,recepcion@x.com).
DRAFRANCISHERRERA_CONTACT_TO=
